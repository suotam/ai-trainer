{
  "@@locale": "en",
  "appTitle": "AI Trainer",
  "@appTitle": {
    "description": "Application title shown in the app shell."
  },
  "startupScreenTitle": "AI Trainer",
  "@startupScreenTitle": {
    "description": "Title on the technical startup screen."
  },
  "startupScreenSubtitle": "Technical bootstrap (R0)",
  "@startupScreenSubtitle": {
    "description": "Subtitle explaining this is a technical R0 screen, not a product feature."
  },
  "startupScreenEnvironmentLabel": "Environment: {environment}",
  "@startupScreenEnvironmentLabel": {
    "description": "Shows which build environment the app is running in.",
    "placeholders": {
      "environment": {
        "type": "String",
        "example": "development"
      }
    }
  },
  "backendStatusChecking": "Checking backend availability…",
  "@backendStatusChecking": {
    "description": "Loading state of the technical backend smoke check."
  },
  "backendStatusReady": "Backend is available and ready ({service} {version})",
  "@backendStatusReady": {
    "description": "Backend liveness and readiness both succeeded.",
    "placeholders": {
      "service": {"type": "String", "example": "ai-trainer-backend"},
      "version": {"type": "String", "example": "0.0.1-dev"}
    }
  },
  "backendStatusNotReady": "Backend is running but not ready to accept traffic",
  "@backendStatusNotReady": {
    "description": "Liveness succeeded but readiness returned not-ready."
  },
  "backendStatusUnavailable": "Backend is not reachable",
  "@backendStatusUnavailable": {
    "description": "Safe failure message; no internal details."
  },
  "backendStatusRetry": "Retry",
  "@backendStatusRetry": {
    "description": "Retry button of the backend smoke check."
  },
  "commonRetry": "Retry",
  "@commonRetry": {
    "description": "Generic retry action label."
  },
  "todayScreenTitle": "Today",
  "@todayScreenTitle": {
    "description": "Title of the Today screen."
  },
  "todayLoading": "Loading today's plan…",
  "@todayLoading": {
    "description": "Loading state of the Today screen."
  },
  "todayEmpty": "Nothing planned for today.",
  "@todayEmpty": {
    "description": "Empty state when there is no workout scheduled for today."
  },
  "todayError": "Couldn't load today's plan.",
  "@todayError": {
    "description": "Safe error message for the Today screen."
  },
  "workoutDurationMinutes": "{minutes} min",
  "@workoutDurationMinutes": {
    "description": "Planned workout duration in whole minutes.",
    "placeholders": {
      "minutes": {"type": "int", "example": "45"}
    }
  },
  "workoutDetailScreenTitle": "Workout",
  "@workoutDetailScreenTitle": {
    "description": "Title of the workout detail screen."
  },
  "workoutDetailLoading": "Loading workout…",
  "@workoutDetailLoading": {
    "description": "Loading state of the workout detail screen."
  },
  "workoutDetailNotFound": "This workout is not available.",
  "@workoutDetailNotFound": {
    "description": "Shown when the workout id does not resolve to a stored workout."
  },
  "workoutDetailError": "Couldn't load this workout.",
  "@workoutDetailError": {
    "description": "Safe error message for the workout detail screen."
  },
  "workoutSectionOptional": "Optional",
  "@workoutSectionOptional": {
    "description": "Badge for an optional workout section."
  },
  "workoutStepSets": "{count, plural, one{{count} set} other{{count} sets}}",
  "@workoutStepSets": {
    "description": "Number of planned sets for an exercise step.",
    "placeholders": {
      "count": {"type": "int", "example": "3"}
    }
  },
  "workoutSetPlanReps": "{reps} reps",
  "@workoutSetPlanReps": {
    "description": "Planned repetitions of a single set.",
    "placeholders": {
      "reps": {"type": "int", "example": "8"}
    }
  },
  "workoutSetPlanWeight": "{weight} kg",
  "@workoutSetPlanWeight": {
    "description": "Planned weight of a single set in kilograms.",
    "placeholders": {
      "weight": {"type": "String", "example": "16"}
    }
  },
  "startWorkoutButton": "Start workout",
  "@startWorkoutButton": {
    "description": "Primary action on the workout detail to start a session."
  },
  "startWorkoutStarting": "Starting…",
  "@startWorkoutStarting": {
    "description": "Label while a session start is in progress."
  },
  "startWorkoutError": "Couldn't start the workout.",
  "@startWorkoutError": {
    "description": "Safe error message when starting a session fails."
  },
  "startWorkoutNotFound": "This workout is not available.",
  "@startWorkoutNotFound": {
    "description": "Shown when starting a workout that does not exist."
  },
  "startWorkoutConflict": "Another workout is already active.",
  "@startWorkoutConflict": {
    "description": "Shown when a different workout already has an active session."
  },
  "startWorkoutConflictOpen": "Open active workout",
  "@startWorkoutConflictOpen": {
    "description": "Action to open the existing active session."
  },
  "activeSessionScreenTitle": "Active session",
  "@activeSessionScreenTitle": {
    "description": "Title of the active session screen."
  },
  "activeSessionLabel": "Session active",
  "@activeSessionLabel": {
    "description": "Status line confirming the session is active."
  },
  "activeSessionStartedAt": "Started at {time}",
  "@activeSessionStartedAt": {
    "description": "Safe start timestamp of the active session.",
    "placeholders": {
      "time": {"type": "String", "example": "2026-07-24 18:12"}
    }
  },
  "activeSessionNotFound": "This session is not available.",
  "@activeSessionNotFound": {
    "description": "Shown when the session id does not resolve to a stored session."
  },
  "activeSessionError": "Couldn't load this session.",
  "@activeSessionError": {
    "description": "Safe error message for the active session screen."
  },
  "trackerNoExercises": "No trackable exercises in this workout.",
  "@trackerNoExercises": {
    "description": "Shown when the active session has no set-based exercises."
  },
  "trackerSetLabel": "Set {number}",
  "@trackerSetLabel": {
    "description": "Label of a single set row.",
    "placeholders": {"number": {"type": "int", "example": "1"}}
  },
  "trackerPlannedSet": "Planned: {reps} reps × {weight} kg",
  "@trackerPlannedSet": {
    "description": "Planned values of a set (immutable snapshot).",
    "placeholders": {
      "reps": {"type": "String", "example": "8"},
      "weight": {"type": "String", "example": "16"}
    }
  },
  "trackerRepsLabel": "Reps",
  "@trackerRepsLabel": {"description": "Actual repetitions input label."},
  "trackerWeightLabel": "Weight (kg)",
  "@trackerWeightLabel": {"description": "Actual weight input label."},
  "trackerSave": "Save",
  "@trackerSave": {"description": "Save actual values for a set."},
  "trackerSaving": "Saving…",
  "@trackerSaving": {"description": "In-progress save label."},
  "trackerSaved": "Saved",
  "@trackerSaved": {"description": "Confirmation that the set was saved."},
  "trackerSaveError": "Couldn't save this set.",
  "@trackerSaveError": {"description": "Safe error when saving a set fails."},
  "trackerValidationError": "Enter valid values.",
  "@trackerValidationError": {"description": "Shown for invalid input."},
  "trackerMarkDone": "Done",
  "@trackerMarkDone": {"description": "Toggle marking the set completed."},
  "trackerCompleted": "Completed",
  "@trackerCompleted": {"description": "Semantic label for a completed set."}
}
